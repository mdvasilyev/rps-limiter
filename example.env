RABBITMQ__LOGS_QUEUE=logs.process

MODEL_REGISTRY__URL=http://localhost:8001/v2

MODEL_DISPATCHER__URL=http://localhost:8002/v1

BOOKING__URL=http://localhost:8003/api/v1

PROMETHEUS__URL=http://localhost:8004

