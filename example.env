WORKER__PROCESS_INTERVAL=5
WORKER__RPS_INTERVAL=5
WORKER__INCREASE_INTERVAL=720
WORKER__UNBOOKING=ALL
WORKER__SCALE_UP_THRESHOLD=20.0
WORKER__SCALE_DOWN_THRESHOLD=5.0
WORKER__WARN_AFTER_MINS=10
WORKER__UNBOOK_AFTER_MINS=20

